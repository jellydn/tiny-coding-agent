{
	"name": "tiny-agent",
	"version": "0.11.0",
	"private": true,
	"type": "module",
	"module": "index.ts",
	"scripts": {
		"dev": "bun --watch index.ts",
		"generate:skills": "bun run scripts/generate-embedded-skills.ts",
		"generate:version": "bun run scripts/generate-version.ts",
		"build": "bun run generate:version && bun run generate:skills && bun build index.ts --compile --outfile=tiny-agent",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"typecheck": "bun run generate:version && bunx --bun tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write --unsafe .",
		"format": "biome format . --write",
		"format:check": "biome format .",
		"prepare": "husky",
		"release:patch": "bun run test && bun run typecheck && bun run lint && bunx bumpp patch --yes",
		"release:minor": "bun run test && bun run typecheck && bun run lint && bunx bumpp minor --yes",
		"release:major": "bun run test && bun run typecheck && bun run lint && bunx bumpp major --yes",
		"pre": "bun run test && bun run typecheck && bun run lint"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.115.0",
		"@modelcontextprotocol/sdk": "^1.25.2",
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/sdk-trace-base": "^2.10.0",
		"@tokenlens/models": "^1.3.0",
		"ink": "^7.1.1",
		"ink-box": "^2.0.0",
		"ink-spinner": "^5.0.0",
		"ollama": "^0.6.3",
		"openai": "^7.0.0",
		"react": "^19.2.3",
		"react-devtools-core": "^7.0.1",
		"tiktoken": "^1.0.15",
		"yaml": "^2.8.2",
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.8",
		"@types/bun": "latest",
		"@types/react": "^19.2.8",
		"bumpp": "^12.0.0",
		"husky": "^9.1.7",
		"typescript": "^7.0.0"
	},
	"peerDependencies": {
		"typescript": "^5 || ^7.0.0"
	},
	"optionalDependencies": {
		"langfuse": "^3.38.20"
	}
}
